<Window x:Class="MinecraftModLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Mod Loader" Height="720" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Minecraft Mod Loader" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Launcher -->
                <GroupBox Header="1. Launcher" Margin="0,0,0,12" Padding="8">
                    <StackPanel>
                        <RadioButton x:Name="RbLegacy" Content="Legacy Launcher" IsChecked="True" Margin="0,4,0,4" Checked="LauncherChanged" Unchecked="LauncherChanged"/>
                        <RadioButton x:Name="RbCustom" Content="Custom" Margin="0,4,0,4" Checked="LauncherChanged" Unchecked="LauncherChanged"/>
                        <StackPanel x:Name="CustomLauncherPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button Content="Browse installer..." Width="140" Click="BrowseCustomLauncher_Click"/>
                            <TextBlock x:Name="CustomLauncherPath" Text="No installer selected" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Version -->
                <GroupBox Header="2. Version" Margin="0,0,0,12" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Choose version (e.g. 1.21.1 Forge):" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VersionCombo" IsEditable="True" Margin="0,0,0,4">
                            <ComboBoxItem Content="1.21.1 Forge" IsSelected="True"/>
                            <ComboBoxItem Content="1.21.1 Fabric"/>
                            <ComboBoxItem Content="1.21.1 NeoForge"/>
                            <ComboBoxItem Content="1.20.1 Forge"/>
                            <ComboBoxItem Content="1.20.1 Fabric"/>
                            <ComboBoxItem Content="1.19.2 Forge"/>
                            <ComboBoxItem Content="1.18.2 Forge"/>
                            <ComboBoxItem Content="1.16.5 Forge"/>
                            <ComboBoxItem Content="1.12.2 Forge"/>
                            <ComboBoxItem Content="1.8.9 Forge"/>
                        </ComboBox>
                        <TextBlock Text="Loader type is part of the version string above." FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <!-- Minecraft path -->
                <GroupBox Header="Minecraft folder" Margin="0,0,0,12" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="McPathBox" Width="420" Margin="0,0,8,0"/>
                            <Button Content="Browse..." Width="80" Click="BrowseMcPath_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Content -->
                <GroupBox Header="3. What to install" Margin="0,0,0,12" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Select one or more (multi-select):" Margin="0,0,0,4"/>
                        <CheckBox x:Name="CbMods" Content="Mods" Margin="0,2" Checked="ContentChecked" Unchecked="ContentUnchecked"/>
                        <CheckBox x:Name="CbResourcePacks" Content="Resource Packs" Margin="0,2" Checked="ContentChecked" Unchecked="ContentUnchecked"/>
                        <CheckBox x:Name="CbShaders" Content="Shaders" Margin="0,2" Checked="ContentChecked" Unchecked="ContentUnchecked"/>
                        <CheckBox x:Name="CbConfigs" Content="Configs" Margin="0,2" Checked="ContentChecked" Unchecked="ContentUnchecked"/>

                        <StackPanel x:Name="ButtonsPanel" Margin="0,8,0,0">
                            <!-- dynamic buttons added in code -->
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Log -->
                <GroupBox Header="Log" Margin="0,0,0,12" Padding="8">
                    <TextBox x:Name="LogBox" Height="120" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BuildBtn" Content="Build" Width="120" Height="32" Click="Build_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
